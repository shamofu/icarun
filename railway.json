{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "watchPatterns": [
      "/apps/mobile/**",
      "/package.json",
      "/pnpm-lock.yaml",
      "/pnpm-workspace.yaml",
      "/.nvmrc",
      "/railway.json",
      "/apps/mobile/railway.json",
      "/.gitattributes"
    ],
    "buildCommand": "pnpm run railway:build:frontend"
  },
  "deploy": {
    "startCommand": "pnpm run railway:start:frontend",
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "preDeployCommand": "pnpm run railway:deploy:frontend",
    "healthcheckTimeout": 300
  }
}
