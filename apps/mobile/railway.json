{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "watchPatterns": [
      "apps/mobile/**",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml"
    ],
    "buildCommand": "pnpm run railway:build:frontend"
  },
  "deploy": {
    "startCommand": "pnpm run railway:start:frontend",
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
