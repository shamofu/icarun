{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "watchPatterns": [
      "/services/database/**",
      "/.gitattributes"
    ],
    "dockerfilePath": "services/database/Dockerfile"
  },
  "deploy": {
    "startCommand": null,
    "restartPolicyType": "ALWAYS",
    "requiredMountPath": "/var/lib/postgresql/data"
  }
}
