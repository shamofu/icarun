{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "watchPatterns": [
      "services/convex-dashboard/**"
    ],
    "dockerfilePath": "services/convex-dashboard/Dockerfile"
  },
  "deploy": {
    "startCommand": null,
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
