# ---------------------------------------------------------------------------
# icarun environment example (Railway + self-hosted Convex edition)
# ---------------------------------------------------------------------------
# This repository is a pnpm workspace that can back multiple Railway services:
#
#   @icarun/mobile             -> frontend SPA service
#   @icarun/convex-backend     -> self-hosted Convex backend image wrapper
#   @icarun/convex-dashboard   -> self-hosted Convex dashboard image wrapper
#   @icarun/database           -> PostgreSQL image wrapper
#
# Do not use docker-compose for Railway. Create separate Railway services from
# the same repository and point each service at its package railway.json file.

# ---------------------------------------------------------------------------
# Frontend service (@icarun/mobile)
# ---------------------------------------------------------------------------
# ONLY EXPO_PUBLIC_* values are bundled into the Expo client.
# Better Auth needs both the Convex API origin (3210) and Convex HTTP/site
# origin (3211). In production these should be browser-reachable public URLs.
# Railway reference variable form depends on how you expose port 3211; see
# docs/deployment.md for the recommended options.
EXPO_PUBLIC_CONVEX_URL=https://your-convex-api.up.railway.app
EXPO_PUBLIC_CONVEX_SITE_URL=https://your-convex-site.up.railway.app

# Public URL of the Expo Web SPA. Better Auth cross-domain cookies validate
# this origin server-side. Set this to the frontend Railway public domain.
SITE_URL=https://your-frontend.up.railway.app

# Self-hosted Convex deploy credentials for the frontend build/deploy service.
# Generate the admin key by SSHing into the convex-backend service and running:
#
#   ./generate_admin_key.sh
#
# These values are used by `convex deploy` during the Railway frontend build.
# Never expose CONVEX_SELF_HOSTED_ADMIN_KEY to client code. Prefer storing it
# as a sealed Railway shared variable after generating it from convex-backend.
CONVEX_SELF_HOSTED_URL=https://your-convex-api.up.railway.app
CONVEX_SELF_HOSTED_ADMIN_KEY=your-self-hosted-convex-admin-key

# ---------------------------------------------------------------------------
# Convex backend service (@icarun/convex-backend)
# ---------------------------------------------------------------------------
# Strong, stable secret for this Convex instance. Set once and keep it stable.
INSTANCE_SECRET=replace-with-a-long-random-secret

# Convex database name is derived from INSTANCE_NAME by replacing '-' with '_'.
# With this value, create/use the PostgreSQL database named convex_self_hosted.
INSTANCE_NAME=convex-self-hosted

# Convex listens on 3210 for the API. HTTP actions/auth routes listen on 3211.
# Railway healthcheck can still target 3210 and /version.
PORT=3210

# Convex POSTGRES_URL must NOT include the database name or query parameters.
POSTGRES_URL=postgresql://convex:replace-with-db-password@database.railway.internal:5432
DO_NOT_REQUIRE_SSL=1

# Public API origin for Convex websocket/query/mutation/action traffic.
CONVEX_CLOUD_ORIGIN=https://your-convex-api.up.railway.app

# Public HTTP/site origin for Convex HTTP actions. Better Auth registers
# /api/auth/* on this origin. It must route to the backend's 3211 listener.
CONVEX_SITE_ORIGIN=https://your-convex-site.up.railway.app
CONVEX_SITE_URL=https://your-convex-site.up.railway.app

DISABLE_METRICS_ENDPOINT=true
RUST_LOG=info

# Better Auth server-side secret. Generate with: openssl rand -base64 32
# Set this on the Convex deployment/backend environment, never as EXPO_PUBLIC_*.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Used by Better Auth cross-domain plugin to trust the frontend SPA origin.
SITE_URL=https://your-frontend.up.railway.app
EXPO_APP_SCHEME=icarun

# OpenAI-compatible provider secrets. Set ONLY on the Convex backend service.
# Never set these as EXPO_PUBLIC_* variables and never expose them to frontend.
OPENAI_API_KEY=sk-your-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# ---------------------------------------------------------------------------
# Convex dashboard service (@icarun/convex-dashboard)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_DEPLOYMENT_URL=https://your-convex-api.up.railway.app

# ---------------------------------------------------------------------------
# Database service (@icarun/database)
# ---------------------------------------------------------------------------
POSTGRES_USER=convex
POSTGRES_PASSWORD=replace-with-db-password
POSTGRES_DB=convex_self_hosted

# Railway volumes can contain lost+found at the mount root. Keep PostgreSQL data
# in a subdirectory to avoid initdb "directory exists but is not empty" errors.
PGDATA=/var/lib/postgresql/data/pgdata

# Attach a Railway volume to the convex-backend service at:
#   /convex/data

# Attach a Railway volume to the database service at:
#   /var/lib/postgresql/data


