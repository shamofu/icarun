# ---------------------------------------------------------------------------
# icarun environment example (Convex edition)
# ---------------------------------------------------------------------------

# Frontend (Expo) - ONLY EXPO_PUBLIC_* values are bundled into the client.
# This value is written automatically by `npx convex dev` into
# apps/mobile/.env.local. It is safe to expose to the client.
EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Managed automatically by the Convex CLI (do NOT set by hand):
# CONVEX_DEPLOYMENT=dev:your-deployment

# ---------------------------------------------------------------------------
# Convex backend secrets - DO NOT put these in any client-facing .env file.
# Set them on the Convex deployment instead (server-side only):
#
#   npx convex env set OPENAI_API_KEY sk-your-key
#   npx convex env set OPENAI_BASE_URL https://api.openai.com/v1
#   npx convex env set OPENAI_MODEL gpt-4.1-mini
#
# Listed here for reference only - these are NEVER read by the Expo client:
# OPENAI_API_KEY=sk-your-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4.1-mini

# ---------------------------------------------------------------------------
# Railway build/deploy secret - set this in Railway service variables only.
# Generate a production deploy key in the Convex dashboard.
# Do not expose this to the Expo client.
# CONVEX_DEPLOY_KEY=prod:your-convex-deploy-key
