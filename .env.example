# ---------------------------------------------------------------------------
# icarun environment example (Railway + self-hosted Convex edition)
# ---------------------------------------------------------------------------
# Create four Railway services from this pnpm workspace. Do not use
# docker-compose for Railway; select each service-specific railway.json.

# ---------------------------------------------------------------------------
# Frontend service (@icarun/mobile)
# ---------------------------------------------------------------------------
# These two values are intentionally bundled into the Expo client.
EXPO_PUBLIC_CONVEX_URL=https://your-convex-api.up.railway.app
EXPO_PUBLIC_CONVEX_SITE_URL=https://your-convex-site.up.railway.app

# Self-hosted Convex deploy credentials. Use the backend private origin. The
# admin key must match the stable INSTANCE_NAME / INSTANCE_SECRET below.
# Store the admin key as a sealed Railway variable; never use EXPO_PUBLIC_*.
CONVEX_SELF_HOSTED_URL=http://convex-backend.railway.internal:3210
CONVEX_SELF_HOSTED_ADMIN_KEY=your-self-hosted-convex-admin-key

# Sources synchronized by the frontend pre-deploy command into the Convex
# FUNCTION environment. Prefixes are removed during sync. These variables are
# not Expo-public and the static-server launcher removes them before serving.
CONVEX_ENV_BETTER_AUTH_SECRET=replace-with-a-long-random-secret
CONVEX_ENV_SITE_URL=https://your-frontend.up.railway.app
CONVEX_ENV_EXPO_APP_SCHEME=icarun

# Optional AI provider values. Omitted values leave existing Convex deployment
# settings unchanged. Keep the API key sealed and never use EXPO_PUBLIC_*.
CONVEX_ENV_OPENAI_API_KEY=sk-your-key
CONVEX_ENV_OPENAI_BASE_URL=https://api.openai.com/v1
CONVEX_ENV_OPENAI_MODEL=gpt-4.1-mini

# Optional bounded wait/retry controls (defaults shown).
# CONVEX_DEPLOY_OVERALL_TIMEOUT_SECONDS=1200
# CONVEX_DEPLOY_WAIT_TIMEOUT_SECONDS=600
# CONVEX_DEPLOY_POLL_INTERVAL_SECONDS=5
# CONVEX_DEPLOY_REQUEST_TIMEOUT_SECONDS=10
# CONVEX_DEPLOY_CLI_TIMEOUT_SECONDS=300
# CONVEX_DEPLOY_MAX_ATTEMPTS=3
# CONVEX_DEPLOY_RETRY_INTERVAL_SECONDS=10

# ---------------------------------------------------------------------------
# Convex backend service (@icarun/convex-backend)
# ---------------------------------------------------------------------------
# Strong stable instance credentials. Generate the admin key from these exact
# values before the first simultaneous deploy, then never rotate one alone.
INSTANCE_SECRET=replace-with-a-long-random-secret
INSTANCE_NAME=convex-self-hosted
PORT=3210

# Convex POSTGRES_URL must NOT include a database name or query parameters.
POSTGRES_URL=postgresql://convex:replace-with-db-password@database.railway.internal:5432
DO_NOT_REQUIRE_SSL=1

# Public origins. API routes to 3210; site/HTTP actions route to 3211.
CONVEX_CLOUD_ORIGIN=https://your-convex-api.up.railway.app
CONVEX_SITE_ORIGIN=https://your-convex-site.up.railway.app
CONVEX_SITE_URL=https://your-convex-site.up.railway.app

DISABLE_METRICS_ENDPOINT=true
RUST_LOG=info

# The wrapper performs bounded TCP reachability checks before starting Convex.
# PostgreSQL credentials are validated by Convex itself after startup.
# DATABASE_WAIT_TIMEOUT_SECONDS=600
# DATABASE_WAIT_INTERVAL_SECONDS=2
# DATABASE_CONNECT_TIMEOUT_SECONDS=5

# ---------------------------------------------------------------------------
# Convex dashboard service (@icarun/convex-dashboard)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_DEPLOYMENT_URL=https://your-convex-api.up.railway.app

# ---------------------------------------------------------------------------
# Database service (@icarun/database)
# ---------------------------------------------------------------------------
POSTGRES_USER=convex
POSTGRES_PASSWORD=replace-with-db-password
POSTGRES_DB=convex_self_hosted
# Store data below the volume root to avoid Railway lost+found initdb failures.
PGDATA=/var/lib/postgresql/data/pgdata

# Required volume mounts:
#   convex-backend -> /convex/data
#   database       -> /var/lib/postgresql/data

# Pinned Convex backend/dashboard source revision (documentary only):
